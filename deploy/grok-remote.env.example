# Generate with `openssl rand -hex 32`; never commit the real value.
GROK_REMOTE_TOKEN=replace-with-a-long-random-token
# Node listens on loopback only; configure the public HTTPS port in the reverse proxy.
GROK_REMOTE_PORT=3000
# Usually unnecessary when the proxy preserves Host/X-Forwarded-Host. Separate multiple origins with commas.
# GROK_REMOTE_ALLOWED_ORIGINS=https://grok.example.com
GROK_REMOTE_PROJECTS_CONFIG=/absolute/path/to/grok-remote/config/projects.json
GROK_BIN=/absolute/path/to/grok

# Optional. Set only when the service does not run under the HOME of the user signed in to Grok.
# GROK_HOME=/absolute/path/to/.grok

# Optional. Must match the shared ai-remote-upload service, with both services using the same Unix account.
# AI_REMOTE_UPLOAD_SOCKET=/var/lib/grok-remote/.local/share/ai-remote/upload.sock

# Optional. Defaults to ~/.grok-remote for this app's event logs and permission mode.
# GROK_REMOTE_STATE_DIR=/var/lib/grok-remote

# Optional. Concurrent worker limit and minimum trustworthy free memory required to start one.
# Linux uses MemAvailable from /proc/meminfo; macOS uses vm_stat. A failed platform reading allows startup with a warning.
# GROK_REMOTE_MAX_WORKERS=4
# GROK_REMOTE_MIN_FREE_MEMORY_MB=512
