# 建议使用 `openssl rand -hex 32` 生成，不要把真实值提交到仓库。
GROK_REMOTE_TOKEN=replace-with-a-long-random-token
# nest 的 Tailscale :8788 入口反代到这个 Node 回环端口。
GROK_REMOTE_PORT=3082
# 正常保留 Host/X-Forwarded-Host 的反向代理不需要设置。多个 Origin 用逗号分隔。
# GROK_REMOTE_ALLOWED_ORIGINS=https://grok.example.com
GROK_REMOTE_PROJECTS_CONFIG=/etc/grok-remote/projects.json
GROK_BIN=/usr/local/bin/grok

# 可选。必须与共享 ai-remote-upload 服务一致，且两个服务使用同一 Unix 账号。
# AI_REMOTE_UPLOAD_SOCKET=/var/lib/grok-remote/.local/share/ai-remote/upload.sock

# 可选。不设时使用 ~/.grok-remote 保存本应用的事件日志和权限模式。
# GROK_REMOTE_STATE_DIR=/var/lib/grok-remote

# 第一版门闩。写代码前第 10 节仍可改；当前按拒绝处理。
# GROK_REMOTE_MAX_WORKERS=2
# GROK_REMOTE_MIN_FREE_MEMORY_MB=512
