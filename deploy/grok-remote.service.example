[Unit]
Description=Grok Remote web application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__APP_DIR__
Environment=HOME=__RUN_HOME__
Environment=PATH=__RUNTIME_PATH__
Environment=NODE_ENV=production
EnvironmentFile=__ENV_FILE__
ExecStart=__NODE_BIN__ __APP_DIR__/src/server/main.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0077

[Install]
WantedBy=multi-user.target
