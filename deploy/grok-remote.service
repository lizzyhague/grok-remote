[Unit]
Description=Grok Remote web application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# 这是需要按实际安装位置修改的模板。建议使用专用的非 root 账户。
User=grok-remote
Group=grok-remote
WorkingDirectory=/opt/grok-remote
Environment=HOME=/var/lib/grok-remote
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
EnvironmentFile=/etc/grok-remote.env
ExecStart=/usr/bin/node /opt/grok-remote/src/server/main.ts
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
UMask=0077

[Install]
WantedBy=multi-user.target
